# Non-secret configuration for agentic tooling. Sourced at every shell start.
# NEVER put keys, tokens, or passwords here; those belong in secrets.env as op:// references.

# Claude Code on Microsoft Foundry (https://code.claude.com/docs/en/microsoft-foundry)
export CLAUDE_CODE_USE_FOUNDRY=1
export ANTHROPIC_FOUNDRY_RESOURCE='<your-foundry-resource-name>'   # placeholder: set your resource name
# Pin deployments; aliases resolve to Claude Code's built-in Foundry defaults otherwise.
export ANTHROPIC_DEFAULT_FABLE_MODEL='claude-fable-5-1'
export ANTHROPIC_DEFAULT_OPUS_MODEL='claude-opus-5'
export ANTHROPIC_DEFAULT_SONNET_MODEL='claude-sonnet-5'
export ANTHROPIC_DEFAULT_HAIKU_MODEL='claude-haiku-4-5'
export ENABLE_PROMPT_CACHING_1H=1

# Hindsight agent memory
export HINDSIGHT_LLM_PROVIDER=claude-code

# Loader behavior (see agentic-secrets.zsh)
# export AGENTIC_SECRETS_AUTOLOAD=1          # eager: resolve secrets at interactive shell start
# export AGENTIC_WRAP_COMMANDS="claude codex opencode"   # lazy wrappers (default: claude)
